# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:replace_me

# Необязательно: ID владельцев через запятую (узнать свой ID — команда /id)
OWNER_IDS=

# Необязательно: ID чата/канала, куда бот будет дублировать журнал модерации
LOG_CHAT_ID=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Путь к базе SQLite (в Docker переопределяется на /data/crymoder.db)
DB_PATH=data/crymoder.db
