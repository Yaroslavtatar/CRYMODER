# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:replace_me

# ID владельцев этого сервера через запятую (узнать свой ID — команда /id; установщик заполняет сам).
# Владельцы видят все чаты в веб-панели, имеют раздел «Админка» и полный доступ.
# Менять удобнее командой: crymoder owner
OWNER_IDS=
# Алиас: дополнительные владельцы (складываются с OWNER_IDS)
SUPER_ADMINS=

# Необязательно: ID чата/канала, куда бот будет дублировать журнал модерации
LOG_CHAT_ID=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Путь к базе SQLite (в Docker переопределяется на /data/crymoder.db)
DB_PATH=data/crymoder.db

# --- Веб-панель (запускается вместе с ботом, тот же процесс и та же база) ---
# 1 — включить, 0 — выключить
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Адрес, по которому панель открывается снаружи (в ссылке, которую бот присылает по слову «панель»)
PUBLIC_URL=http://localhost:8000

# Часовой пояс для дат в ответах бота (смещение от UTC, часы)
TZ_OFFSET_HOURS=3
